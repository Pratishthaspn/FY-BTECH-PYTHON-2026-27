<%- include('layout/header', { title: 'AI Assistant', pageTitle: 'CRM AI Assistant', activePage: 'ai' }) %>

<div class="ai-page-grid" data-ai-root data-ai-is-admin="<%= currentUser && currentUser.role === 'admin' ? '1' : '0' %>" data-ai-initial-mode="<%= initialMode %>" data-ai-initial-customer="<%= initialCustomerId || '' %>" data-ai-initial-prompt="<%= initialPrompt %>">
  <!-- Main Multi-Turn Chat Card -->
  <div class="card ai-chat-card">
    <div class="card-header ai-chat-header">
      <div class="card-title">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
        </svg>
        <span>CRM Copilot</span>
      </div>
      <div class="ai-header-actions">
        <select class="form-control ai-compact-select" data-ai-speed aria-label="Assistant engine">
          <option value="local" selected>Built-in (No API Key)</option>
          <option value="standard">Gemini AI · Standard</option>
          <option value="fast">Gemini AI · Fast</option>
        </select>
        <button type="button" class="btn btn-secondary btn-sm" data-ai-clear>New Chat</button>
      </div>
    </div>

    <!-- Role / Mode Selector -->
    <div class="ai-mode-bar" role="tablist" aria-label="Assistant Roles">
      <button type="button" class="ai-mode-btn active" data-ai-mode-btn="general">All CRM</button>
      <button type="button" class="ai-mode-btn" data-ai-mode-btn="insights">Customer Insights</button>
      <button type="button" class="ai-mode-btn" data-ai-mode-btn="message">Message Generator</button>
      <button type="button" class="ai-mode-btn" data-ai-mode-btn="followups">Smart Follow-ups</button>
      <button type="button" class="ai-mode-btn" data-ai-mode-btn="analytics">Business Analytics</button>
      <button type="button" class="ai-mode-btn" data-ai-mode-btn="history">Customer History</button>
    </div>

    <!-- Context Controls -->
    <div class="ai-context-bar">
      <div class="ai-context-field">
        <label class="ai-context-label" for="aiPageCustomer">Customer Context</label>
        <select id="aiPageCustomer" class="form-control ai-compact-select" data-ai-customer>
          <option value="">All Customers (Workspace)</option>
          <% customers.forEach(c => { %>
            <option value="<%= c.id %>" <%= initialCustomerId === c.id ? 'selected' : '' %>><%= c.name %><%= c.company ? ' (' + c.company + ')' : '' %></option>
          <% }); %>
        </select>
      </div>
      <div class="ai-context-field" data-ai-message-options style="display: none;">
        <label class="ai-context-label" for="aiPageChannel">Channel</label>
        <select id="aiPageChannel" class="form-control ai-compact-select" data-ai-channel>
          <option value="Email">Email</option>
          <option value="WhatsApp">WhatsApp</option>
          <option value="Reply">Query Reply</option>
        </select>
      </div>
      <div class="ai-context-field" data-ai-message-options style="display: none;">
        <label class="ai-context-label" for="aiPageTone">Tone</label>
        <select id="aiPageTone" class="form-control ai-compact-select" data-ai-tone>
          <option value="Friendly">Friendly</option>
          <option value="Formal">Formal</option>
          <option value="Persuasive">Persuasive</option>
        </select>
      </div>
    </div>

    <!-- Scrollable Conversation Thread -->
    <div class="ai-thread" data-ai-thread aria-live="polite"></div>

    <!-- Error / Notice Banner -->
    <div class="ai-status-banner" data-ai-error style="display: none;"></div>

    <!-- Composer -->
    <form class="ai-composer" data-ai-form>
      <textarea
        class="form-control ai-input"
        data-ai-input
        rows="2"
        placeholder="Ask about active customers, overdue follow-ups, report summaries, or draft a WhatsApp/email reply..."
        required
      ></textarea>
      <button type="submit" class="btn btn-primary ai-send-btn" data-ai-submit>Send</button>
    </form>
  </div>

  <!-- Right Column: 5 Capability Prompt Starters -->
  <div class="ai-sidebar-panel">
    <div class="card">
      <div class="card-header">
        <div class="card-title"><span>1. Customer Insights</span></div>
      </div>
      <div class="card-body ai-prompt-list">
        <button type="button" class="ai-prompt-chip" data-ai-prompt="Who are my most active customers?" data-ai-mode="insights">Who are my most active customers?</button>
        <button type="button" class="ai-prompt-chip" data-ai-prompt="Which customers haven't been contacted recently?" data-ai-mode="insights">Which customers haven't been contacted recently?</button>
        <button type="button" class="ai-prompt-chip" data-ai-prompt="Show customers with pending follow-ups." data-ai-mode="insights">Show customers with pending follow-ups.</button>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <div class="card-title"><span>2. Follow-up Message Generator</span></div>
      </div>
      <div class="card-body ai-prompt-list">
        <button type="button" class="ai-prompt-chip" data-ai-prompt="Draft a formal follow-up email based on the latest interaction." data-ai-mode="message" data-ai-set-channel="Email" data-ai-set-tone="Formal">Draft formal follow-up email</button>
        <button type="button" class="ai-prompt-chip" data-ai-prompt="Draft a friendly WhatsApp follow-up message." data-ai-mode="message" data-ai-set-channel="WhatsApp" data-ai-set-tone="Friendly">Draft friendly WhatsApp message</button>
        <button type="button" class="ai-prompt-chip" data-ai-prompt="Suggest a persuasive response to address any open customer queries." data-ai-mode="message" data-ai-set-channel="Reply" data-ai-set-tone="Persuasive">Suggest persuasive query response</button>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <div class="card-title"><span>3. Smart Follow-up Assistant</span></div>
      </div>
      <div class="card-body ai-prompt-list">
        <button type="button" class="ai-prompt-chip" data-ai-prompt="Identify overdue follow-ups and prioritize customers needing attention." data-ai-mode="followups">Identify overdue &amp; priority follow-ups</button>
        <button type="button" class="ai-prompt-chip" data-ai-prompt="Suggest when to contact inactive or pending customers again and propose follow-up tasks for approval." data-ai-mode="followups">Suggest next contact dates &amp; tasks</button>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <div class="card-title"><span>4. Business Analytics Assistant</span></div>
      </div>
      <div class="card-body ai-prompt-list">
        <button type="button" class="ai-prompt-chip" data-ai-prompt="How many customers are active, and which status has the most customers?" data-ai-mode="analytics">Active count &amp; top status</button>
        <button type="button" class="ai-prompt-chip" data-ai-prompt="Summarize this month's interactions and overall CRM reports." data-ai-mode="analytics">Summarize this month's interactions &amp; reports</button>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <div class="card-title"><span>5. Customer History Summary</span></div>
      </div>
      <div class="card-body ai-prompt-list">
        <button type="button" class="ai-prompt-chip" data-ai-prompt="Summarize previous calls and meetings, show the latest interaction, highlight unresolved queries, and give pre-contact context." data-ai-mode="history">Summarize calls, latest activity &amp; unresolved queries</button>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="aiInitialHistoryData"><%- JSON.stringify(history || []).replace(/</g, '\\u003c') %></script>

<%- include('layout/footer', { hideAiDrawer: true }) %>
