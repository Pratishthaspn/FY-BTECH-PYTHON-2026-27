      </main>
    </div>

  </div>

  <!-- ====================================================================
       UNIVERSAL ADD CUSTOMER MODAL (Accessible from any page via topbar)
       ==================================================================== -->
  <% if (currentUser && currentUser.role !== 'customer') { %>
  <div class="modal-overlay" id="addCustomerModal" role="dialog" aria-modal="true" aria-labelledby="addCustomerModalTitle">
    <div class="modal-dialog">
      <div class="modal-header">
        <h3 class="modal-title" id="addCustomerModalTitle">+ Add New Customer</h3>
        <button type="button" class="modal-close-btn" data-modal-close>&times;</button>
      </div>
      <form action="/customers/add" method="POST">
        <input type="hidden" name="_csrf_token" value="<%= csrfToken %>">
        <div class="modal-body">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="add_name">Full Name <span class="required">*</span></label>
              <input type="text" id="add_name" name="name" class="form-control" placeholder="e.g. Aarav Sharma" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="add_company">Company / Business</label>
              <input type="text" id="add_company" name="company" class="form-control" placeholder="e.g. Sharma Electronics">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="add_email">Email Address <span class="required">*</span></label>
              <input type="email" id="add_email" name="email" class="form-control" placeholder="name@example.com" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="add_phone">Phone Number <span class="required">*</span></label>
              <input type="tel" id="add_phone" name="phone" class="form-control" placeholder="e.g. 9876543210" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="add_status">Customer Status</label>
              <select id="add_status" name="status" class="form-control">
                <option value="Active" selected>Active</option>
                <option value="Pending">Pending</option>
                <option value="Inactive">Inactive</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="add_address">Address / City</label>
              <input type="text" id="add_address" name="address" class="form-control" placeholder="City or Street Address">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="add_notes">Notes / Requirements</label>
            <textarea id="add_notes" name="notes" class="form-control" placeholder="Client preferences, potential deal size, or context..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn-primary">Save Customer</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ====================================================================
       UNIVERSAL DELETE CONFIRMATION MODAL
       ==================================================================== -->
  <div class="modal-overlay" id="deleteConfirmModal" role="dialog" aria-modal="true" aria-labelledby="deleteConfirmTitle">
    <div class="modal-dialog" style="max-width: 440px;">
      <div class="modal-header">
        <h3 class="modal-title" id="deleteConfirmTitle" style="color: #dc2626;">Confirm Deletion</h3>
        <button type="button" class="modal-close-btn" data-modal-close>&times;</button>
      </div>
      <form id="universalDeleteForm" method="POST">
        <input type="hidden" name="_csrf_token" value="<%= csrfToken %>">
        <div class="modal-body">
          <p id="deleteConfirmItemText" style="color: #475569; font-size: 0.92rem;">
            Are you sure you want to delete this record? This action cannot be undone.
          </p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn-danger">Yes, Delete Record</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <% if (!locals.hideAiDrawer && currentUser && currentUser.role !== 'customer') { %>
  <aside class="ai-drawer" id="aiAssistantDrawer" aria-hidden="true" role="dialog" aria-label="CRM AI Assistant">
    <div class="ai-drawer-panel" data-ai-root data-ai-is-admin="<%= currentUser.role === 'admin' ? '1' : '0' %>" data-ai-drawer="1">
      <div class="ai-drawer-header">
        <div class="card-title">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
          </svg>
          <span>CRM AI Assistant</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
          <a href="/ai-assistant" class="btn btn-secondary btn-sm">Full View</a>
          <button type="button" class="btn btn-secondary btn-sm" data-ai-clear>Clear</button>
          <button type="button" class="modal-close-btn" id="closeAiDrawerBtn" aria-label="Close AI Assistant">&times;</button>
        </div>
      </div>

      <div class="ai-mode-bar ai-mode-bar-compact" role="tablist" aria-label="Assistant Modes">
        <button type="button" class="ai-mode-btn active" data-ai-mode-btn="general">All</button>
        <button type="button" class="ai-mode-btn" data-ai-mode-btn="insights">Insights</button>
        <button type="button" class="ai-mode-btn" data-ai-mode-btn="message">Message</button>
        <button type="button" class="ai-mode-btn" data-ai-mode-btn="followups">Follow-ups</button>
        <button type="button" class="ai-mode-btn" data-ai-mode-btn="analytics">Analytics</button>
        <button type="button" class="ai-mode-btn" data-ai-mode-btn="history">History</button>
      </div>

      <div class="ai-context-bar ai-context-bar-compact">
        <select class="form-control ai-compact-select" data-ai-customer aria-label="Customer context">
          <option value="">All Customers</option>
        </select>
        <select class="form-control ai-compact-select" data-ai-speed aria-label="Assistant engine">
          <option value="local" selected>Built-in (No API Key)</option>
          <option value="standard">Gemini · Standard</option>
          <option value="fast">Gemini · Fast</option>
        </select>
        <select class="form-control ai-compact-select" data-ai-channel data-ai-message-options style="display: none;" aria-label="Channel">
          <option value="Email">Email</option>
          <option value="WhatsApp">WhatsApp</option>
          <option value="Reply">Reply</option>
        </select>
        <select class="form-control ai-compact-select" data-ai-tone data-ai-message-options style="display: none;" aria-label="Tone">
          <option value="Friendly">Friendly</option>
          <option value="Formal">Formal</option>
          <option value="Persuasive">Persuasive</option>
        </select>
      </div>

      <div class="ai-drawer-chips">
        <button type="button" class="ai-prompt-chip" data-ai-prompt="Who are my most active customers?" data-ai-mode="insights">Most active</button>
        <button type="button" class="ai-prompt-chip" data-ai-prompt="Identify overdue follow-ups and suggest tasks for approval." data-ai-mode="followups">Overdue follow-ups</button>
        <button type="button" class="ai-prompt-chip" data-ai-prompt="Summarize this month's interactions and CRM reports." data-ai-mode="analytics">Report summary</button>
      </div>

      <div class="ai-thread" data-ai-thread aria-live="polite"></div>
      <div class="ai-status-banner" data-ai-error style="display: none;"></div>

      <form class="ai-composer" data-ai-form>
        <textarea
          class="form-control ai-input"
          data-ai-input
          rows="2"
          placeholder="Ask CRM AI anything..."
          required
        ></textarea>
        <button type="submit" class="btn btn-primary ai-send-btn" data-ai-submit>Send</button>
      </form>
    </div>
  </aside>
  <% } %>

  <!-- Application Interactive Scripts -->
  <script src="/static/js/script.js"></script>
  <% if (locals.customScripts) { %>
    <%- locals.customScripts %>
  <% } %>

</body>
</html>
