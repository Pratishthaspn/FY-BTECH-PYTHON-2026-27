<!DOCTYPE html>
<html lang="en" data-theme="<%= locals.settings && settings.theme ? settings.theme : 'light' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= setupRequired ? 'Create Admin' : 'Sign In' %> - CRM</title>
  <meta name="description" content="Customer Relationship Management (CRM) web application featuring customer directory CRUD, interaction history, follow-up scheduling, and analytical reporting.">
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('crm-theme');
        if (saved === 'dark' || saved === 'light' || saved === 'indigo') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
  <div class="auth-theme-corner">
    <button type="button" class="btn btn-secondary btn-sm theme-toggle-btn" id="themeToggleBtn" aria-label="Toggle dark mode" title="Switch Light / Dark Mode">
      <svg data-theme-icon="moon" width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
      </svg>
      <svg data-theme-icon="sun" width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display: none;">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
      </svg>
      <span data-theme-label>Dark</span>
    </button>
  </div>
  <main class="auth-page">
    <section class="card" style="width: min(100%, 460px);">
      <div class="card-header">
        <div class="card-title"><%= setupRequired ? 'Create the first admin' : 'Sign in to CRM' %></div>
      </div>
      <div class="card-body">
        <% if (locals.flashMessages && locals.flashMessages.length > 0) { %>
          <% locals.flashMessages.forEach(msg => { %>
            <div class="alert alert-<%= msg.category %>"><%= msg.message %></div>
          <% }); %>
        <% } %>
        <form method="POST" action="<%= setupRequired ? '/setup-admin' : '/login' %>">
          <input type="hidden" name="_csrf_token" value="<%= csrfToken %>">
          <input type="hidden" name="next" value="<%= locals.nextUrl || '' %>">
          <div class="form-group">
            <label class="form-label" for="email"><%= setupRequired ? 'Admin email' : 'Email' %></label>
            <input class="form-control" id="email" name="email" type="email" autocomplete="username" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="password"><%= setupRequired ? 'Password (minimum 12 characters)' : 'Password' %></label>
            <input class="form-control" id="password" name="password" type="password" minlength="<%= setupRequired ? 12 : 1 %>" autocomplete="<%= setupRequired ? 'new-password' : 'current-password' %>" required>
          </div>
          <% if (setupRequired) { %>
            <div class="form-group">
              <label class="form-label" for="confirm_password">Confirm password</label>
              <input class="form-control" id="confirm_password" name="confirm_password" type="password" minlength="12" autocomplete="new-password" required>
            </div>
          <% } %>
          <button class="btn btn-primary" type="submit" style="width: 100%; justify-content: center;">
            <%= setupRequired ? 'Create admin account' : 'Sign in' %>
          </button>
        </form>
        <% if (setupRequired) { %>
          <p style="font-size: 0.82rem; color: var(--text-muted); text-align: center; margin-top: 16px;">
            Already have an account? <a href="/login<%= locals.nextUrl ? '?next=' + encodeURIComponent(locals.nextUrl) : '' %>">Sign in</a>
          </p>
        <% } else if (locals.noUsersYet) { %>
          <p style="font-size: 0.82rem; color: var(--text-muted); text-align: center; margin-top: 16px;">
            No admin account yet? <a href="/setup-admin<%= locals.nextUrl ? '?next=' + encodeURIComponent(locals.nextUrl) : '' %>">Create the first admin</a>
          </p>
        <% } else { %>
          <p style="font-size: 0.82rem; color: var(--text-muted); margin-top: 14px;">Need a password reset? Contact your CRM administrator.</p>
        <% } %>
      </div>
    </section>
  </main>
  <script src="/static/js/script.js"></script>
</body>
</html>
